# Copy to .env and fill in. Put real keys in .env only; this file is committed.

# Mempool path (tx command). Either ALCHEMY_WSS_URL or ALCHEMY_API_KEY is enough;
# if only the key is set, the mainnet WSS URL is built from it.
ALCHEMY_API_KEY=
ALCHEMY_WSS_URL=

# Contract path (contract command)
ETHERSCAN_API_KEY=

# LLM provider. Only groq is implemented.
LLM_PROVIDER=groq
GROQ_API_KEY=
# Any chat model your Groq account can access (GET /openai/v1/models).
GROQ_MODEL=openai/gpt-oss-120b

# debug | info | warn | error
LOG_LEVEL=info
